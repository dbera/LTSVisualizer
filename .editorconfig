# EditorConfig helps maintain consistent coding styles across editors.
# See https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 88

# JavaScript, TypeScript, React, JSON, CSS, HTML
[*.{js,jsx,ts,tsx,json,css,scss,html}]
indent_size = 2

# YAML files, including GitHub Actions and issue forms
[*.{yml,yaml}]
indent_size = 2

# Markdown preserves intentional trailing spaces used for line breaks.
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2

# Windows command scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

# PlantUML and plain-text samples
[*.{puml,plantuml,txt}]
indent_size = 2

# Makefiles require tabs.
[Makefile]
indent_style = tab
